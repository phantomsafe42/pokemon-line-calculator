{
  "name": "pokemon-line-calculator",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "scripts": {
    "check:items:reference": "node tools/verify_item_reference.mjs",
    "check:items:sweep": "node tools/verify_held_item_sweep.mjs && node tools/verify_held_item_damage.mjs && node tools/verify_held_item_passive.mjs && node tools/verify_held_item_inventory.mjs",
    "test": "node tools/run_portable_tests.mjs",
    "test:contract": "node --test tests/contract.test.mjs tests/graph.test.mjs",
    "test:browser": "node tests/public_browser_smoke.mjs",
    "test:browser:public": "node tests/public_browser_smoke.mjs",
    "build:move-reference": "node tools/build_showdown_move_reference.mjs",
    "check:move-reference": "node tools/build_showdown_move_reference.mjs --check",
    "sync:workspace-dependencies": "node tools/sync_workspace_dependencies.mjs --sync",
    "check:workspace-dependencies": "node tools/sync_workspace_dependencies.mjs --check",
    "check:generated": "node tools/verify_generated_dependencies.mjs",
    "sync:assets": "node tools/project_public_assets.mjs --write",
    "check:assets": "node tools/project_public_assets.mjs --check",
    "build:public": "node tools/build_public.mjs && node tools/check_public_build.mjs",
    "check:public": "node tools/check_public_build.mjs",
    "check:publication": "node tools/check_repository_publication.mjs",
    "check": "node tools/check_javascript_syntax.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
